# =============================================================================
# Environment configuration template.
# Copy this file to EACH environment file you need and fill in the values:
#   cp .env.example .env.dev          # for `npm run dev`
#   cp .env.example .env.qa           # for `npm run dev:qa` / build:qa
#   cp .env.example .env.stage        # for `npm run dev:stage` / build:stage
#   cp .env.example .env.production    # for `npm run build`
# Then set VITE_APP_ENV in each to its mode (dev / qa / stage / production).
# NEVER commit any real .env / .env.<mode> / *.local file.
# =============================================================================
#
#   Mode        Command                         Authoritative file
#   ---------   -----------------------------   ----------------------
#   dev         npm run dev                      .env.dev
#   qa          npm run dev:qa / build:qa        .env.qa
#   stage       npm run dev:stage / build:stage  .env.stage
#   production  npm run build                     .env.production
#
# Each mode's file is SELF-CONTAINED — it holds every variable that command
# needs. The base `.env` deliberately holds NO secrets, so it can't silently
# backfill a value missing from a mode's own file.
#
# Every command runs `scripts/check-env.mjs` first and refuses to start/build
# if a required variable is missing from the mode's file or is a placeholder.
# -----------------------------------------------------------------------------

# Supabase Configuration (REQUIRED — validated before start/build)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App Configuration
VITE_APP_NAME=Puppy Profile
# VITE_APP_ENV is set per-mode in .env.dev / .env.qa / .env.stage / .env.production
VITE_APP_ENV=dev

# TEMPORARY — set to false when real Supabase credentials are available
VITE_USE_MOCK_AUTH=true
