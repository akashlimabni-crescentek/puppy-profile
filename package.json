{
  "name": "puppy-profile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check-env": "node scripts/check-env.mjs",
    "dev": "node scripts/check-env.mjs dev && vite --mode dev",
    "dev:qa": "node scripts/check-env.mjs qa && vite --mode qa",
    "dev:stage": "node scripts/check-env.mjs stage && vite --mode stage",
    "dev:prod": "node scripts/check-env.mjs production && vite --mode production",
    "build": "node scripts/check-env.mjs production && tsc && vite build --mode production",
    "build:dev": "node scripts/check-env.mjs dev && tsc && vite build --mode dev",
    "build:qa": "node scripts/check-env.mjs qa && tsc && vite build --mode qa",
    "build:stage": "node scripts/check-env.mjs stage && tsc && vite build --mode stage",
    "build:prod": "node scripts/check-env.mjs production && tsc && vite build --mode production",
    "preview": "vite preview",
    "preview:qa": "vite preview --mode qa",
    "preview:stage": "vite preview --mode stage",
    "preview:prod": "vite preview --mode production",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src/**/*.{ts,tsx,css}",
    "format:check": "prettier --check src/**/*.{ts,tsx,css}",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "src/**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "lucide-react": "^1.18.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.78.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.17.0",
    "redux-saga": "^1.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.4.4",
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/react": "^10.4.4",
    "@storybook/react-vite": "^10.4.4",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "storybook": "^10.4.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
